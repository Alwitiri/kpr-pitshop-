{
  "name": "kpr-pitstop",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "seed": "tsx prisma/seed.ts",
    "seed:clean": "cross-env SEED_DEMO=0 tsx prisma/seed.ts",
    "setup": "prisma db push && tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "migration:new": "node scripts/new-migration.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.17",
    "jsbarcode": "^3.12.3",
    "next": "16.4.6",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": ">=20.9"
  }
}
